{
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu24.04",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y clangd",
  "remoteUser": "vscode"
}